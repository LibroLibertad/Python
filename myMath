def slope(x1,y1,x2,y2):
    return (y2-y1)/(x2-x1)

def triangleArea(base, height):
    return 0.5*base*height

def isTriangle(a,b,c):
    return (a + b > c) and (a + c > b) and (b + c > a)

def heronsFormula(a,b,c):
    if isTriangle(a,b,c):
        s = (a+b+c)/2
        radicand = s*(s-a)*(s-b)*(s-c)
        return radicand**(1/2)
    else:
        print("The three sides do not make a triangle.")

def squareArea(sideLength):
    return sideLength**2

def trapezoidArea(altitude, base1, base2):
    return (1/2)*altitude*(base1 + base2)

def trianglePerimeter(a,b,c):
    return a+b+c
    
def squarePerimeter(sideLength):
    return sideLength*4
    
def rectanglePerimeter(length,width):
    return (length+width)*2

def circumference(r):
    return 2*pi*r

def parallelogramPerimeter(base,side):
    return (base+side)*2

def trapezoidPerimeter(base1,base2,leg1,leg2):
    return base1+base2+leg1+leg2
    
def rectangleArea(length,width):
    return length*width

def circleArea(r):
    return pi*r**2

def parallelogramArea(base,altitude):
    return base*altitude

def cubeSurfaceArea(sideLength):
    return 6*sideLength**2

def cylinderSurfaceArea(r,h):
    return 2*pi*r**2+2*pi*r*h

def coneSurfaceArea(r,h):
    return pi*r*h

def sphereSurfaceArea(r):
    return 4*pi*r**2

def cubeVolume(sideLength):
    return sideLength**3

def cylinderVolume(r,h):
    return pi*r**2*h

def coneVolume(r,h):
    return 1/3*pi*r**2*h

def sphereVolume(r):
    return 4/3*pi*r**3
